# BetIQ Environment Variables
# Copy this to .env and fill in the values

# Neon Postgres Database (connection string from Neon dashboard)
DATABASE_URL=

# Clerk Authentication
# Get these from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI API Key (for AI analysis)
# Falls back to mock analysis when not set
OPENAI_API_KEY=

# Sports Data Provider
# Choose one provider option:
#   Option A: Generic — set SPORTS_API_KEY + SPORTS_API_URL
#   Option B: The Odds API — set ODDS_API_KEY
#   Option C: Set SPORTS_PROVIDER=mock for mock data (default when no keys are set)
SPORTS_API_KEY=
SPORTS_API_URL=
ODDS_API_KEY=
SPORTS_PROVIDER=     # "mock" | "real" | "odds-api" (auto-detected from the keys above)

# Stripe (for subscriptions)
STRIPE_SECRET_KEY=